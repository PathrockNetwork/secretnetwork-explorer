# ── Secret CometBFT RPC endpoints (failover order = priority) ───────────────
# HTTP RPC for /status, /block, /validators  |  WebSocket for NewBlock events
# Endpoints whose VAR is unset are skipped with a warning at startup.
SECRET_RPC_URL=https://rpc.secret.mainnet.secret3.dev
SECRET_RPC_WS_URL=wss://rpc.secret.mainnet.secret3.dev/websocket
# Optional failover endpoint (see chains/secret.yaml).
# SECRET_RPC_URL_2=https://rpc.example-2.com
# SECRET_RPC_WS_URL_2=wss://rpc.example-2.com/websocket

# ── Secret LCD (x/staking, x/slashing, x/gov) ───────────────────────────────
SECRET_LCD_URL=https://lcd.secret.mainnet.secret3.dev
# SECRET_LCD_URL_2=https://lcd.example-2.com

# ── Postgres (local dev; matches docker-compose.yml) ────────────────────────
POSTGRES_USER=sealed
POSTGRES_PASSWORD=sealed
POSTGRES_DB=sealed_monitor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://sealed:sealed@localhost:5432/sealed_monitor

# ── Indexer tuning ──────────────────────────────────────────────────────────
# How many blocks to backfill backward from head on startup.
BACKFILL_DEPTH=50000
# Validator-set poll cadence (ms).
POLL_INTERVAL_MS=60000
# Endpoint probe / reselect cadence (ms).
# ENDPOINT_PROBE_INTERVAL_MS=30000
# Gap scan cadence and per-sweep repair cap.
# GAP_SCAN_INTERVAL_MS=300000
# Raw signature retention: blocks kept counting back from head (must exceed
# the 10,000-block long window plus the 5,000-block detail view) and sweep
# cadence for rolling older rows into validator_signing_daily.
# SIGNATURE_RETAIN_BLOCKS=12000
# SIGNATURE_RETENTION_SWEEP_MS=21600000
# Moniker refresh cadence (ms).
# MONIKER_SYNC_INTERVAL_MS=3600000

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
# Interface to bind. Defaults to 127.0.0.1 so the API is never accidentally
# published to the public internet. Set this to your Tailscale address
# (`tailscale ip -4`) to reach the dashboard over the tailnet.
# API_HOST=100.81.166.104
# Hostname of the public facade (deploy/Caddyfile). Requests arriving with this
# Host get endpoint/LCD URLs and failure text redacted.
# PUBLIC_HOST=secretnetwork.explorer.pathrocknetwork.org
# Which chains/*.yaml slug the API serves. Defaults to the first chain indexed.
# CHAIN_SLUG=secret-mainnet

# ── Database timeouts (fail fast so the UI can show "unreachable") ──────────
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=12000

# ── yaci transaction index (deploy/sealed-yaci*.service) ────────────────────
# yaci reads blocks over gRPC (needs server reflection) into its own database.
# When YACI_DATABASE_URL is set the API serves transactions and address
# history from it, falling back to the LCD for anything not indexed yet.
# YACI_GRPC=grpc.example.com:443
# YACI_DATABASE_URL=postgres://sealed:sealed@localhost:5432/sealed_yaci

# Optional deeper-history LCDs (comma-separated), asked only for an address's
# txs or a tx hash older than every block the main node and yaci hold.
# SECRET_LCD_HISTORY_URLS=https://rest.lavenderfive.com:443/secretnetwork
